<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>С 23 Февраля!</title>

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            background: linear-gradient(135deg, #0b5d1e, #1f8a3a);
        }

        /* Флаговая анимация */
        .flag {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                to bottom,
                rgba(255,255,255,0.15) 33%,
                rgba(0,57,166,0.15) 33%,
                rgba(0,57,166,0.15) 66%,
                rgba(213,43,30,0.15) 66%
            );
            animation: wave 6s ease-in-out infinite alternate;
            z-index: 0;
        }

        @keyframes wave {
            from { transform: translateY(-10px); }
            to { transform: translateY(10px); }
        }

        /* Звёзды */
        body::before {
            content: "";
            position: absolute;
            width: 200%;
            height: 200%;
            background-image: radial-gradient(gold 2px, transparent 2px);
            background-size: 50px 50px;
            animation: moveStars 25s linear infinite;
            opacity: 0.25;
            z-index: 0;
        }

        @keyframes moveStars {
            from { transform: translate(0, 0); }
            to { transform: translate(-300px, -300px); }
        }

        .container {
            position: relative;
            z-index: 2;
            text-align: center;
            width: 90%;
            max-width: 600px;
        }

        .card {
            background: linear-gradient(145deg, #b30000, #ff1a1a);
            color: white;
            padding: 40px;
            border-radius: 25px;
            box-shadow: 0 0 40px rgba(255,0,0,0.6);
            animation: fadeIn 0.8s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }

        .stars {
            font-size: 30px;
            margin-bottom: 20px;
            animation: glow 2s infinite alternate;
        }

        @keyframes glow {
            from { text-shadow: 0 0 5px yellow; }
            to { text-shadow: 0 0 25px gold; }
        }

        .medals {
            font-size: 28px;
            margin-bottom: 15px;
        }

        button {
            margin: 10px;
            padding: 12px 30px;
            font-size: 18px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.3s;
        }

        .yes {
            background: gold;
            color: #b30000;
            font-weight: bold;
        }

        .yes:hover {
            transform: scale(1.1);
            box-shadow: 0 0 20px gold;
        }

        .no {
            background: #222;
            color: white;
        }

        .no:hover {
            transform: scale(1.1);
            box-shadow: 0 0 15px white;
        }

        .hidden {
            display: none;
        }

        #resultText {
            white-space: pre-line;
            font-size: 20px;
            line-height: 1.5;
        }

        canvas {
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
            pointer-events: none;
        }
    </style>
</head>
<body>

<div class="flag"></div>
<canvas id="fireworks"></canvas>
<audio id="music" autoplay loop>
    <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
</audio>

<div class="container">

    <div id="page1" class="card">
        <div class="medals">🎖️ 🏅 ⭐ 🛡️</div>
        <div class="stars">★ ★ ★ ★ ★</div>
        <h1>С Праздником! 🇷🇺</h1>
        <h2>Служил?</h2>
        <button class="yes" onclick="servedYes()">Да</button>
        <button class="no" onclick="servedNo()">Нет</button>
    </div>

    <div id="page2" class="card hidden">
        <div class="medals">🎖️ 🏅 ⭐ 🛡️</div>
        <div class="stars">★ ★ ★ ★ ★</div>
        <h2>В крайне необходимой ситуации будешь защищать Родину?</h2>
        <button class="yes" onclick="defendYes()">Да</button>
        <button class="no" onclick="defendNo()">Нет</button>
    </div>

    <div id="result" class="card hidden">
        <div class="medals">🎖️ 🏅 ⭐ 🛡️</div>
        <div class="stars">★ ★ ★ ★ ★</div>
        <p id="resultText"></p>
    </div>

</div>

<script>
    const canvas = document.getElementById('fireworks');
    const ctx = canvas.getContext('2d');
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    let particles = [];

    function createFirework() {
        for (let i = 0; i < 80; i++) {
            particles.push({
                x: canvas.width / 2,
                y: canvas.height / 2,
                angle: Math.random() * 2 * Math.PI,
                speed: Math.random() * 5 + 2,
                radius: 2,
                life: 100
            });
        }
    }

    function animateFireworks() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach((p, index) => {
            p.x += Math.cos(p.angle) * p.speed;
            p.y += Math.sin(p.angle) * p.speed;
            p.life--;

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fillStyle = 'gold';
            ctx.fill();

            if (p.life <= 0) particles.splice(index, 1);
        });
        requestAnimationFrame(animateFireworks);
    }

    animateFireworks();

    function servedYes() {
        switchPage('page1');
        createFirework();
        document.getElementById('resultText').textContent =
        "Гражданский ты или военный, с концом родился ты не зря, сегодня праздник мужичинный, с 23 февраля!!!";
    }

    function servedNo() {
        document.getElementById('page1').classList.add('hidden');
        document.getElementById('page2').classList.remove('hidden');
    }

    function defendYes() {
        switchPage('page2');
        createFirework();
        document.getElementById('resultText').textContent =
        "Хоть не носишь ты мундира,\nНо знаем мы, что в трудный час\nНе станешь, Геор, дизертиром,\nСпасешь ты Родину и нас!!!\nА вообще пусть в жизни все проходит мимо\nКроме денег и интима";
    }

    function defendNo() {
        switchPage('page2');
        document.getElementById('resultText').textContent =
        "Не расстраивай страну и Вику, отвечай да";
    }

    function switchPage(hideId) {
        document.getElementById(hideId).classList.add('hidden');
        document.getElementById('result').classList.remove('hidden');
    }
</script>

</body>
</html>
